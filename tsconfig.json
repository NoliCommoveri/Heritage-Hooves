{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"],
  // test/market/sale-d1.test.ts is the one file in this repo that talks to Node itself (node:sqlite,
  // node:fs) rather than to the Workers runtime, so it needs @types/node - and @types/node's globals
  // conflict with @cloudflare/workers-types, which every other file here is checked against. Adding
  // @types/node to make one test file type-check would weaken the type checking on all of src/, so
  // the file is excluded from tsc instead. It still runs under vitest, which type-strips rather than
  // type-checks. See that file's own header for what it is and why it exists.
  "exclude": [
    "test/incidents/risk.test.ts",
    "test/incidents/incidents-d1.test.ts",
    "test/market/sale-d1.test.ts",
    "test/npc/market-d1.test.ts",
    "test/founding/consignment-d1.test.ts",
    "test/reset-d1.test.ts",
    "test/npc/buying-d1.test.ts",
    "test/market/sell-into-offer-d1.test.ts",
    "test/market/stud-d1.test.ts",
    "test/npc/stud-d1.test.ts",
    "test/npc/show-barn-d1.test.ts",
    "test/npc/pet-home-d1.test.ts",
    "test/market/breed-and-stud-pickers-d1.test.ts",
    "test/health/pedigree-panel-d1.test.ts",
    "test/showing/young-and-ability-classes-d1.test.ts",
    "test/showing/rank-and-on-demand-d1.test.ts",
    "test/ageing/geld-d1.test.ts",
    "test/showing/show-barn-fill-d1.test.ts",
    // Not a database test, but the same reason: it reads src/router.ts off disk (node:fs) so that
    // the two halves of the routing table are compared against each other rather than against a
    // hand-copied list in the test.
    "test/router-paths.test.ts",
    // Same again: reads src/routes/market.ts off disk to check the listing page still offers what
    // the buy handler accepts. See its own header.
    "test/market/same-account-buy.test.ts",
    // Same again, both of them: they read migrations/0142 and migrations/0144 off disk so the
    // seeded breed numbers are asserted where they actually live rather than hand-copied into a
    // test that would then have to be kept in step with every retune.
    "test/genetics/breed-ability-bias.test.ts",
    "test/showing/breed-aptitude.test.ts",
    // Same again: reads src/routes/horses.ts and src/render/horses.ts off disk to check that every
    // POST on the horse page redirects back to a named tab, and that all four tabs still have cards
    // behind them. Its pure half is test/horse-tabs.test.ts, which is type-checked normally.
    "test/horse-tabs-source.test.ts"
  ]
}
